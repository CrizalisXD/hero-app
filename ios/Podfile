# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

# Keep the Unity targets' product directory in sync with Runner's.
#
# Flutter injects CONFIGURATION_BUILD_DIR (build/ios/iphoneos) into Generated.xcconfig for
# `flutter run` and omits it for `flutter build ios`, but that xcconfig only reaches the
# Runner project. The Unity targets live in Unity-iPhone.xcodeproj, so when the override is
# present they keep writing to the default build/ios/$(CONFIGURATION)-iphoneos while Runner
# looks for UnityFramework.framework in build/ios/iphoneos — the "No such file or directory"
# failure. Attaching UnityBuildDir.xcconfig (which includes Generated.xcconfig) as their base
# configuration makes them follow Runner in both cases; a literal path would go stale, since
# pod install does not re-run on every flutter run.
#
# Both targets in the chain need it: GameAssembly emits il2cpp.a / libGameAssembly.a into
# $CONFIGURATION_BUILD_DIR, and UnityFramework links against them via the same variable.
UNITY_PINNED_TARGETS = %w[UnityFramework GameAssembly].freeze

def pin_unity_to_flutter_build_dir
  unity_project_path = File.expand_path(File.join('..', 'UnityLibrary', 'Unity-iPhone.xcodeproj'), __FILE__)
  return unless File.exist?(unity_project_path)

  unity_project = Xcodeproj::Project.open(unity_project_path)

  # Match on basename: new_file stores the path relative to the project (../Flutter/...),
  # so looking it up by absolute path never hits and every pod install would add a duplicate.
  xcconfig_path = File.expand_path(File.join('..', 'Flutter', 'UnityBuildDir.xcconfig'), __FILE__)
  xcconfig_ref = unity_project.files.find { |f| File.basename(f.path.to_s) == 'UnityBuildDir.xcconfig' } ||
                 unity_project.new_file(xcconfig_path)

  UNITY_PINNED_TARGETS.each do |target_name|
    target = unity_project.targets.find { |t| t.name == target_name }
    raise "#{target_name} target not found in Unity-iPhone.xcodeproj" if target.nil?

    target.build_configurations.each do |config|
      config.base_configuration_reference = xcconfig_ref
    end
  end
  unity_project.save
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  pin_unity_to_flutter_build_dir

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # flutter_unity_widget imports UnityFramework, but its podspec only searches
    # ${PODS_CONFIGURATION_BUILD_DIR} (build/ios/$(CONFIGURATION)-iphoneos). The Unity
    # targets follow Runner instead (see pin_unity_to_flutter_build_dir), which lands them
    # in build/ios/iphoneos whenever Flutter sets CONFIGURATION_BUILD_DIR. Search both
    # candidates — Xcode ignores the one that doesn't exist for the current invocation.
    if target.name == 'flutter_unity_widget'
      target.build_configurations.each do |config|
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] = [
          '$(inherited)',
          '"${PODS_ROOT}/../../build/ios/iphoneos"',
        ]
      end
    end

    # permission_handler — disable all permissions we DON'T use so the
    # app doesn't abort at launch for missing Info.plist usage descriptions.
    # We only use Permission.notification (Phase 11). To re-enable a permission,
    # set its macro to 1 here AND add the matching NS*UsageDescription to
    # ios/Runner/Info.plist.
    # Reference: https://pub.dev/packages/permission_handler#ios
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        ## dart: PermissionGroup.calendar
        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        ## dart: PermissionGroup.reminders
        'PERMISSION_REMINDERS=0',
        ## dart: PermissionGroup.contacts
        'PERMISSION_CONTACTS=0',
        ## dart: PermissionGroup.camera
        'PERMISSION_CAMERA=0',
        ## dart: PermissionGroup.microphone
        'PERMISSION_MICROPHONE=0',
        ## dart: PermissionGroup.speech
        'PERMISSION_SPEECH_RECOGNIZER=0',
        ## dart: PermissionGroup.photos
        'PERMISSION_PHOTOS=0',
        ## dart: [PermissionGroup.location, PermissionGroup.locationAlways, PermissionGroup.locationWhenInUse]
        'PERMISSION_LOCATION=0',
        ## dart: PermissionGroup.notification — KEEP ENABLED (Phase 11)
        # 'PERMISSION_NOTIFICATIONS=0',
        ## dart: PermissionGroup.mediaLibrary
        'PERMISSION_MEDIA_LIBRARY=0',
        ## dart: PermissionGroup.sensors
        'PERMISSION_SENSORS=0',
        ## dart: PermissionGroup.bluetooth
        'PERMISSION_BLUETOOTH=0',
        ## dart: PermissionGroup.appTrackingTransparency
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        ## dart: PermissionGroup.criticalAlerts
        'PERMISSION_CRITICAL_ALERTS=0',
        ## dart: PermissionGroup.assistant
        'PERMISSION_ASSISTANT=0',
      ]
    end
  end
end
